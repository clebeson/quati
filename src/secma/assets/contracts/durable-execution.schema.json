{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable ExecutionRef",
  "type": "object",
  "required": [
    "execution_id",
    "commitment_id",
    "engine",
    "workflow_type",
    "binding_version",
    "status",
    "idempotency_key"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "commitment_id": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "string",
      "enum": [
        "dbos",
        "temporal",
        "mock"
      ]
    },
    "workflow_type": {
      "type": "string",
      "minLength": 1
    },
    "binding_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "WAITING",
        "SUCCEEDED",
        "FAILED",
        "CANCEL_REQUESTED",
        "CANCELLED",
        "UNKNOWN"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
