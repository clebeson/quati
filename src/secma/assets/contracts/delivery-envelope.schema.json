{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery envelope",
  "type": "object",
  "required": [
    "delivery_id",
    "commitment_id",
    "recipient_id",
    "recipient_kind",
    "channel_id",
    "state",
    "body_ref",
    "idempotency_key",
    "created_at"
  ],
  "properties": {
    "delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "commitment_id": {
      "type": "string",
      "minLength": 1
    },
    "recipient_id": {
      "type": "string",
      "minLength": 1
    },
    "recipient_kind": {
      "type": "string",
      "enum": [
        "human",
        "system"
      ]
    },
    "channel_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "PENDING",
        "ATTEMPTED",
        "SENT",
        "UNKNOWN",
        "FAILED",
        "ACKNOWLEDGED"
      ]
    },
    "body_ref": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
