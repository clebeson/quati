{
  "type": "object",
  "properties": {
    "seal_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "SPEC_READY",
        "CONTRACT_READY",
        "TEST_PLAN_READY",
        "SECURITY_REVIEWED",
        "TESTS_VERIFIED",
        "EVIDENCE_VERIFIED",
        "INDEPENDENT_AUDIT_PASSED",
        "SLICE_ACCEPTED",
        "RELEASE_READY"
      ]
    },
    "scope_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "independent_of_authors": {
          "type": "boolean"
        }
      },
      "required": [
        "identity",
        "role",
        "independent_of_authors"
      ],
      "additionalProperties": false
    },
    "artifact_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proof_tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "L0",
          "L1",
          "L2",
          "L3",
          "L4",
          "L5"
        ]
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "unresolved_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "source_snapshot": {
      "type": "object",
      "properties": {
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "manifest_path",
        "manifest_sha256"
      ],
      "additionalProperties": false
    },
    "commit_evidence": {
      "type": "object",
      "required": [
        "commit_sha",
        "test_log_ref",
        "transcript_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "test_log_ref": {
          "type": "string",
          "minLength": 1
        },
        "transcript_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": [
    "seal_id",
    "kind",
    "scope_ids",
    "verdict",
    "issued_at",
    "issuer",
    "requirement_ids",
    "test_ids",
    "evidence_refs",
    "proof_tiers",
    "rationale",
    "unresolved_findings",
    "supersedes",
    "signature",
    "evidence_sha256"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "INDEPENDENT_AUDIT_PASSED",
              "SECURITY_REVIEWED",
              "EVIDENCE_VERIFIED"
            ]
          },
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "issuer": {
            "properties": {
              "independent_of_authors": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "unresolved_findings": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "oneOf": [
    {
      "required": [
        "source_snapshot",
        "artifact_sha256"
      ],
      "not": {
        "required": [
          "commit_evidence"
        ]
      }
    },
    {
      "required": [
        "commit_evidence"
      ],
      "not": {
        "required": [
          "source_snapshot"
        ]
      }
    }
  ]
}
