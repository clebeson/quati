{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCS capability manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "name",
    "description",
    "intents",
    "input_schema",
    "output_schema",
    "outcomes",
    "permissions",
    "effects",
    "requires_approval",
    "dependencies",
    "lifecycle",
    "assurance",
    "evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": "scs/1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 40
    },
    "intents": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Intent examples",
      "type": "object",
      "required": [
        "positive_examples",
        "negative_examples"
      ],
      "properties": {
        "positive_examples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "outcomes": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "OutcomeContract",
      "type": "object",
      "required": [
        "criteria"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "effects": {
      "type": "string",
      "enum": [
        "none",
        "read",
        "write",
        "dangerous"
      ]
    },
    "requires_approval": {
      "type": "boolean"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "validated",
        "staged",
        "enabled",
        "deprecated",
        "disabled"
      ]
    },
    "assurance": {
      "type": "string",
      "enum": [
        "DRAFT",
        "C0",
        "C1",
        "C2",
        "C3",
        "C4",
        "C5"
      ]
    },
    "evaluation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "effects": {
            "enum": [
              "write",
              "dangerous"
            ]
          }
        },
        "required": [
          "effects"
        ]
      },
      "then": {
        "properties": {
          "requires_approval": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "enabled"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "assurance": {
            "enum": [
              "C2",
              "C3",
              "C4",
              "C5"
            ]
          }
        }
      }
    }
  ]
}
