{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "Executive request classification",
  "type": "object",
  "required": [
    "intent",
    "work_needed",
    "complexity",
    "risk",
    "uncertainty",
    "safe_work_allowed",
    "next_action",
    "reason_code"
  ],
  "properties": {
    "intent": {
      "enum": [
        "social",
        "simple_answer",
        "status_query",
        "context_lookup",
        "professional_work",
        "deep_investigation",
        "external_action"
      ]
    },
    "work_needed": {
      "type": "boolean"
    },
    "complexity": {
      "enum": [
        "trivial",
        "short",
        "multi_step",
        "investigative"
      ]
    },
    "risk": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ]
    },
    "uncertainty": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "safe_work_allowed": {
      "type": "boolean"
    },
    "next_action": {
      "enum": [
        "respond",
        "search_context",
        "start_safe_work",
        "ask",
        "escalate",
        "deny"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 3
    },
    "commitment_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
