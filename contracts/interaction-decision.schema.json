{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ERI interaction decision",
  "description": "Final interaction decision for one turn, timer or async result. Sole producer: M03 via InteractionPort.decide; persisted by M07 via InteractionPort.apply. M04 (reference resolution), M05 (clarification eligibility) and M06 (communication kind and timing) supply inputs but never emit this type.",
  "type": "object",
  "required": [
    "request_id",
    "commitment_id",
    "action",
    "reason_code",
    "message",
    "safe_work",
    "question_blocking",
    "next_contact_at"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "commitment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "RECEIPT",
        "ANSWER",
        "START_SAFE_WORK",
        "ASK",
        "WAIT",
        "UPDATE",
        "OFFER_PARTIAL",
        "ESCALATE",
        "DELIVER"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "safe_work": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "question_blocking": {
      "type": "boolean"
    },
    "next_contact_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
