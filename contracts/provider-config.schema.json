{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quati.local/contracts/provider-config.schema.json",
  "title": "ProviderConfig list (M17)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providers"
  ],
  "properties": {
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ProviderConfig"
      }
    }
  },
  "$defs": {
    "ProviderConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "transport",
        "allowed_data_classes",
        "probe_required",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "transport": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "Registered Provider transport name; unknown names fail with NOT_CONFIGURED TRANSPORT_UNKNOWN at load."
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "secret_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:.+$",
          "description": "Reference only (for example env:NAME); never a secret value or a sign-in file path."
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "allowed_data_classes": {
          "type": "array",
          "items": {
            "enum": [
              "public_synthetic",
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "uniqueItems": true
        },
        "probe_required": {
          "type": "array",
          "items": {
            "enum": [
              "tools",
              "structured_output",
              "streaming",
              "timeout",
              "concurrency"
            ]
          },
          "uniqueItems": true
        },
        "max_usd_per_run": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "status": {
          "enum": [
            "NOT_PROBED",
            "NOT_CONFIGURED",
            "PROBED"
          ]
        }
      }
    }
  }
}
