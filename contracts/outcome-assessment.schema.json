{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sufficiency verdict",
  "type": "object",
  "required": [
    "commitment_id",
    "goal_revision",
    "verdict",
    "evidence_refs",
    "gaps",
    "confidence",
    "next_action"
  ],
  "properties": {
    "commitment_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_revision": {
      "type": "integer",
      "minimum": 0
    },
    "verdict": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "INVESTIGATE_MORE",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "ACCEPT"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          },
          "gaps": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
