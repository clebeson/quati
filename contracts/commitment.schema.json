{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commitment",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "requester_id",
    "goal",
    "state",
    "revision",
    "channel",
    "next_update_at",
    "created_at",
    "outcome_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "requester_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "UNDERSTANDING",
        "ACCEPTED",
        "EXECUTING",
        "WAITING_INPUT",
        "REVIEWING",
        "COMPLETED",
        "PARTIAL",
        "BLOCKED",
        "CANCELLED",
        "FAILED"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "next_update_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
