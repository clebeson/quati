{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quati v2 durable commitment; S02 normative target, not an implemented migration",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "requester_id",
    "goal",
    "state",
    "revision",
    "channel",
    "next_update_at",
    "created_at",
    "outcome_ref",
    "schema_version",
    "outcome_verdict",
    "goal_revision",
    "next_action",
    "deadline_at",
    "responsible_actor_id",
    "block_reason",
    "blocked_from_state",
    "effect_state",
    "effect_intent_refs",
    "delivery_attempt_refs",
    "evidence_refs",
    "assessment_ref",
    "assessed_goal_revision",
    "transition_count",
    "reinvestigation_count",
    "control_policy_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "requester_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "ACKNOWLEDGED",
        "BLOCKED",
        "CANCELLED",
        "CANCELLED_WITH_EFFECTS",
        "CANCEL_REQUESTED",
        "CLASSIFIED",
        "DELIVERED",
        "EFFECT_UNCERTAIN",
        "EVIDENCE_REVIEW",
        "IN_PROGRESS",
        "NEEDS_RECONCILIATION",
        "READY_TO_DELIVER",
        "RECEIVED",
        "SEND_PENDING",
        "WAITING_INPUT"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "next_update_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "quati-commitment/2"
    },
    "outcome_verdict": {
      "enum": [
        "UNKNOWN",
        "ACCEPT",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "goal_revision": {
      "type": "integer",
      "minimum": 0
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "deadline_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "responsible_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "block_reason": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(DEADLINE_ELAPSED|BUDGET_EXHAUSTED\\.(transitions|reinvestigations|requests|tool_calls|cost|delivery_attempts))$"
    },
    "blocked_from_state": {
      "anyOf": [
        {
          "enum": [
            "ACKNOWLEDGED",
            "BLOCKED",
            "CANCELLED",
            "CANCELLED_WITH_EFFECTS",
            "CANCEL_REQUESTED",
            "CLASSIFIED",
            "DELIVERED",
            "EFFECT_UNCERTAIN",
            "EVIDENCE_REVIEW",
            "IN_PROGRESS",
            "NEEDS_RECONCILIATION",
            "READY_TO_DELIVER",
            "RECEIVED",
            "SEND_PENDING",
            "WAITING_INPUT"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "effect_state": {
      "enum": [
        "NONE",
        "PENDING",
        "CONFIRMED",
        "UNCERTAIN",
        "CONFIRMED_ABSENT"
      ]
    },
    "effect_intent_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delivery_attempt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessment_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "assessed_goal_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "transition_count": {
      "type": "integer",
      "minimum": 0
    },
    "reinvestigation_count": {
      "type": "integer",
      "minimum": 0
    },
    "control_policy_version": {
      "const": "2.0.0"
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "default": "P2",
      "description": "Urgency/priority proposed by M08 classification and persisted by M07. P0 is highest."
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "description": "Owning space (RFC-013). Not a guard input."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "not": {
              "enum": [
                "DELIVERED",
                "CANCELLED",
                "CANCELLED_WITH_EFFECTS"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "deadline_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "block_reason": {
            "type": "string",
            "minLength": 1
          },
          "blocked_from_state": {
            "enum": [
              "ACKNOWLEDGED",
              "BLOCKED",
              "CANCELLED",
              "CANCELLED_WITH_EFFECTS",
              "CANCEL_REQUESTED",
              "CLASSIFIED",
              "DELIVERED",
              "EFFECT_UNCERTAIN",
              "EVIDENCE_REVIEW",
              "IN_PROGRESS",
              "NEEDS_RECONCILIATION",
              "READY_TO_DELIVER",
              "RECEIVED",
              "SEND_PENDING",
              "WAITING_INPUT"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "READY_TO_DELIVER",
              "SEND_PENDING",
              "DELIVERED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "assessment_ref": {
            "type": "string",
            "minLength": 1
          },
          "assessed_goal_revision": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_refs": {
            "minItems": 1
          },
          "outcome_verdict": {
            "enum": [
              "ACCEPT",
              "PARTIAL"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "EFFECT_UNCERTAIN",
              "NEEDS_RECONCILIATION"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "effect_state": {
            "const": "UNCERTAIN"
          },
          "effect_intent_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "DELIVERED"
          }
        }
      },
      "then": {
        "properties": {
          "delivery_attempt_refs": {
            "minItems": 1
          },
          "effect_state": {
            "const": "CONFIRMED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "CANCELLED"
          }
        }
      },
      "then": {
        "properties": {
          "effect_state": {
            "enum": [
              "NONE",
              "CONFIRMED_ABSENT"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "CANCELLED_WITH_EFFECTS"
          }
        }
      },
      "then": {
        "properties": {
          "effect_state": {
            "const": "CONFIRMED"
          },
          "effect_intent_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "SEND_PENDING"
          }
        }
      },
      "then": {
        "properties": {
          "effect_state": {
            "const": "PENDING"
          },
          "effect_intent_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
