{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brain document",
  "type": "object",
  "required": [
    "provider_id",
    "document_id",
    "version",
    "tenant_id",
    "space_id",
    "title",
    "content_ref",
    "source_uri",
    "retrieved_at",
    "acl_ref",
    "content_sha256"
  ],
  "properties": {
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "description": "Owning space (RFC-013 \u00a72); visibility derives from the space kind and its grants"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "content_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_uri": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "acl_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Derived from the space grants at retrieval time; never authored by the provider"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "description": "A document returned by a brain provider. Access is decided by space_id grants (RFC-013), not by provider-declared visibility."
}
