{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brain document",
  "type": "object",
  "required": [
    "provider_id",
    "document_id",
    "version",
    "tenant_id",
    "visibility",
    "title",
    "content_ref",
    "source_uri",
    "retrieved_at",
    "acl_ref"
  ],
  "properties": {
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "team",
        "organization",
        "public"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "content_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_uri": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "acl_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
