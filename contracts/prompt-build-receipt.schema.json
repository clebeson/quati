{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "Deterministic prompt build receipt",
  "type": "object",
  "required": [
    "behavior_id",
    "behavior_version",
    "behavior_hash",
    "statechart_hash",
    "prompt_hash",
    "sections",
    "token_budget",
    "model_profile_ref",
    "compiler_version",
    "policy_ref",
    "policy_hash",
    "source_versions",
    "effective_limits"
  ],
  "properties": {
    "behavior_id": {
      "type": "string"
    },
    "behavior_version": {
      "type": "string"
    },
    "behavior_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "statechart_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "token_budget": {
      "type": "integer",
      "minimum": 256
    },
    "model_profile_ref": {
      "type": "string"
    },
    "compiler_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "policy_ref": {
      "const": "trusted_policy/default"
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_versions": {
      "type": "object",
      "required": [
        "behavior",
        "statechart"
      ],
      "properties": {
        "behavior": {
          "type": "string"
        },
        "statechart": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "effective_limits": {
      "type": "object",
      "required": [
        "max_context_tokens",
        "max_capability_candidates",
        "max_investigation_loops",
        "max_transitions"
      ],
      "properties": {
        "max_context_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_capability_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "max_investigation_loops": {
          "type": "integer",
          "minimum": 0
        },
        "max_transitions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
