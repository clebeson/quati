{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "Versioned behavior profile",
  "type": "object",
  "required": [
    "id",
    "version",
    "role",
    "interaction",
    "execution",
    "statechart_ref",
    "models",
    "context",
    "policy_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "role": {
      "type": "string",
      "minLength": 3
    },
    "interaction": {
      "type": "object",
      "required": [
        "verbosity",
        "cadence",
        "clarification_style",
        "language_policy"
      ],
      "properties": {
        "verbosity": {
          "enum": [
            "brief",
            "balanced",
            "detailed"
          ]
        },
        "cadence": {
          "enum": [
            "quiet",
            "balanced",
            "active"
          ]
        },
        "clarification_style": {
          "enum": [
            "only_blocking",
            "value_based"
          ]
        },
        "language_policy": {
          "enum": [
            "requester",
            "explicit_override"
          ]
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "default_depth",
        "max_investigation_loops",
        "safe_read_ahead"
      ],
      "properties": {
        "default_depth": {
          "enum": [
            "quick",
            "progressive",
            "deep"
          ]
        },
        "max_investigation_loops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "safe_read_ahead": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "required": [
        "router_role",
        "specialist_role"
      ],
      "properties": {
        "router_role": {
          "type": "string"
        },
        "specialist_role": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [
        "max_context_tokens",
        "max_capability_candidates"
      ],
      "properties": {
        "max_context_tokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 200000
        },
        "max_capability_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "additionalProperties": false
    },
    "statechart_ref": {
      "type": "string",
      "minLength": 3
    },
    "policy_ref": {
      "type": "string",
      "minLength": 3
    },
    "notes": {
      "type": "string"
    }
  }
}
