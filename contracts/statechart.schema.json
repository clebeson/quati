{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "Declarative SECMA statechart",
  "type": "object",
  "required": [
    "id",
    "version",
    "initial",
    "states",
    "terminal",
    "budget",
    "transitions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "initial": {
      "type": "string"
    },
    "states": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "terminal": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "max_transitions",
        "max_reinvestigations"
      ],
      "properties": {
        "max_transitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_reinvestigations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "additionalProperties": false
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "event",
          "target",
          "guard",
          "action"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "guard": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
